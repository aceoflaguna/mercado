    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Rizal St, Manila, Philippines\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json().data;",
                  "pm.collectionVariables.set('orderId', data.id);",
                  "pm.test('Order has line items', function () { pm.expect(data.items.length).to.be.above(0); });"
                ]
              }
            }
          ],
          "description": "Turns the buyer's current cart into an order inside a single DB transaction: locks the cart, re-checks stock, decrements it, snapshots the price, then clears the cart. Run 'Cart > Add To Cart' first so there's something to check out."
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "header": [],
            "url": "{{baseUrl}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout - Insufficient Stock (expect 409)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Rizal St, Manila, Philippines\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 (empty cart) since the previous checkout already cleared it', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "description": "Run 'Checkout' above first (which empties the cart), then run this immediately after: it demonstrates the empty-cart guard (400). To see the actual 409 insufficient-stock/rollback behavior, add more to the cart than remaining stock (e.g. run 'Add To Cart' with a large quantity right after Checkout, then run this request) and watch stock/cart stay untouched afterward."
        }
      ]
    },
    {
      "name": "Error Cases",
      "description": "Validation, auth, and role-enforcement checks. Independent of the happy-path flow above (aside from needing Setup to have run once for buyerEmail).",
      "item": [
        {
          "name": "Register - Weak Password (expect 400)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"123\",\n  \"name\": \"Weak\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Invalid Email (expect 400)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"validpass123\",\n  \"name\": \"Bad Email\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
