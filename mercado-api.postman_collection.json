{
  "info": {
    "_postman_id": "6f2a2b0a-6c1a-4e4b-9c2e-mercado0001",
    "name": "Mercado API",
    "description": "Shopee-style marketplace API. Run folders top to bottom in order: Setup → Categories → Products → Cart → Orders. Health and Error Cases can be run any time. Registration uses {{$randomEmail}} so the whole collection is safely re-runnable without truncating the database between runs.\n\nSet the `baseUrl` variable (defaults to http://localhost:3000) if your server runs elsewhere.\n\nAdmin bootstrap: there is no public admin signup by design. Run 'Setup > Register Admin (bootstrap)', then manually run the SQL shown in that request's description against your Postgres database, then run 'Setup > Login Admin'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "buyerToken", "value": "", "type": "string" },
    { "key": "buyerId", "value": "", "type": "string" },
    { "key": "buyerEmail", "value": "", "type": "string" },
    { "key": "sellerToken", "value": "", "type": "string" },
    { "key": "sellerId", "value": "", "type": "string" },
    { "key": "sellerEmail", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "adminId", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status field is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Setup",
      "description": "Run these first, top to bottom. Creates a buyer, a seller, and (optionally) an admin, and captures their tokens into collection variables used by every other folder.",
      "item": [
        {
          "name": "Register Buyer",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"BuyerPass123!\",\n  \"name\": \"Bob Buyer\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json().data;",
                  "pm.collectionVariables.set('buyerToken', data.token);",
                  "pm.collectionVariables.set('buyerId', data.user.id);",
                  "pm.collectionVariables.set('buyerEmail', data.user.email);",
                  "pm.test('Role is buyer', function () { pm.expect(data.user.role).to.eql('buyer'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Seller",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"SellerPass123!\",\n  \"name\": \"Sofia Seller\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json().data;",
                  "pm.collectionVariables.set('sellerToken', data.token);",
                  "pm.collectionVariables.set('sellerId', data.user.id);",
                  "pm.collectionVariables.set('sellerEmail', data.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Become Seller",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
            },
            "header": [],
            "url": "{{baseUrl}}/api/auth/become-seller"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json().data;",
                  "pm.test('Role is now seller', function () { pm.expect(data.user.role).to.eql('seller'); });",
                  "pm.collectionVariables.set('sellerToken', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me (Buyer)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Email matches registered buyer', function () { pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('buyerEmail')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Admin (bootstrap)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"AdminPass123!\",\n  \"name\": \"Amy Admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json().data;",
                  "pm.collectionVariables.set('adminId', data.user.id);",
                  "pm.collectionVariables.set('adminEmail', data.user.email);",
                  "console.log('Captured adminEmail =', data.user.email);",
                  "console.log('Now run this SQL against Postgres, then run \"Login Admin\":');",
                  "console.log(\"UPDATE users SET role = 'admin' WHERE email = '\" + data.user.email + \"';\");"
                ]
              }
            }
          ],
          "description": "There is no public endpoint to create an admin (intentionally — don't expose that). After running this request, promote the account manually:\n\n```sql\nUPDATE users SET role = 'admin' WHERE email = '{{adminEmail}}';\n```\n\nThen run 'Login Admin' below to get an admin token. Check the Postman Console (View > Show Postman Console) after running this request — it prints the exact SQL with the captured email filled in."
        },
        {
          "name": "Login Admin (after DB promotion)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"AdminPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json().data;",
                  "pm.collectionVariables.set('adminToken', data.token);",
                  "pm.test('Role is admin (did you run the SQL promotion first?)', function () { pm.expect(data.user.role).to.eql('admin'); });"
                ]
              }
            }
          ],
          "description": "Run this only after manually promoting {{adminEmail}} to role='admin' in Postgres. If the role check below fails, the SQL promotion hasn't been applied yet."
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('categoryId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "description": "Requires {{adminToken}} — run Setup > Register Admin + the manual SQL promotion + Login Admin first. Category name includes a timestamp so this can be re-run without a unique-slug conflict."
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product (Seller)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"A great wireless mouse\",\n  \"categoryId\": {{categoryId}},\n  \"priceCents\": 2999,\n  \"stock\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('productId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "description": "Requires {{sellerToken}} (run Setup > Become Seller first) and {{categoryId}} (run Categories > Create Category first)."
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [],
            "url": "{{baseUrl}}/api/products?search=mouse&page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has pagination info', function () { pm.expect(pm.response.json()).to.have.property('pagination'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product (Seller)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceCents\": 2599,\n  \"stock\": 8\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Stock updated to 8', function () { pm.expect(pm.response.json().data.stock).to.eql(8); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart (empty)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "header": [],
            "url": "{{baseUrl}}/api/cart"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
